# DeepSeek API Key（必填）
# 在 https://platform.deepseek.com/ 注册获取
DEEPSEEK_API_KEY=sk-your-key-here

# Hermes 消息投递目标（必填）
# 格式：platform:chat_id
# QQ 示例：PROACTIVE_DELIVER_TARGET=qqbot:YOUR_QQ_OPENID
# Telegram 示例：PROACTIVE_DELIVER_TARGET=telegram:-1001234567890
# Discord 示例：PROACTIVE_DELIVER_TARGET=discord:999888777
PROACTIVE_DELIVER_TARGET=qqbot:YOUR_OPENID_HERE

# 活跃阈值秒数（选填，默认 600 = 10分钟）
# 用户在 N 秒内有消息时就跳过，不打扰
# PROACTIVE_ACTIVE_THRESHOLD=600

# 安静时段（选填，默认 23:00 ~ 07:30）
# PROACTIVE_QUIET_START=1380    # 23:00（分钟偏移）
# PROACTIVE_QUIET_END=450       # 07:30
